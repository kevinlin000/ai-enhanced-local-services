# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hmdp
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# LINE Login
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_REDIRECT_URI=http://localhost:8081/api/auth/line/callback
LINE_INTERNAL_WEBHOOK_SECRET=replace_with_shared_internal_secret
LINE_ACTION_SECRET=replace_with_shared_action_secret

# Local portfolio/demo helper. Set false outside local demo environments.
DEMO_MODE_ENABLED=true
