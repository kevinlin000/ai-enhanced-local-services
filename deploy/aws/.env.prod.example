# 全部填完才能 up。每個 secret 都要是新產生的值（舊值已出現在開發機截圖，一律輪換）。
# 產生方式：openssl rand -hex 32

PUBLIC_DOMAIN=bytebites.example.com

MYSQL_PASSWORD=
RABBITMQ_USER=bytebites
RABBITMQ_PASS=

# 至少 64 字元
JWT_SECRET=

# LINE Login channel（Java 用）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE Messaging API channel（Python 用）
LINE_MSG_CHANNEL_SECRET=
LINE_MSG_CHANNEL_ACCESS_TOKEN=

# Java ↔ Python 內部通知；兩個值必須不同
LINE_INTERNAL_WEBHOOK_SECRET=
LINE_ACTION_SECRET=

GEMINI_API_KEY=

# TapPay sandbox
NEXT_PUBLIC_TAPPAY_APP_ID=
NEXT_PUBLIC_TAPPAY_APP_KEY=
NEXT_PUBLIC_TAPPAY_ENV=sandbox
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_CREDITCARD=
