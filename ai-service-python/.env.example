JAVA_BACKEND_URL=http://localhost:8081
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shops
GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# LINE Messaging API bot
LINE_CHANNEL_SECRET=your_line_messaging_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_messaging_channel_access_token
LINE_SIGNATURE_VERIFY=true
LINE_REPLY_ENABLED=false
LINE_INTERNAL_WEBHOOK_SECRET=replace_with_same_value_as_backend
LINE_INTERNAL_WEBHOOK_REQUIRE_SECRET=true
LINE_ACTION_SECRET=replace_with_same_value_as_backend

# Public HTTPS web URL used in LINE Flex card buttons/images.
# For local demo, use an ngrok HTTPS URL that forwards to http://localhost:3000.
LINE_PUBLIC_WEB_URL=http://localhost:3000
