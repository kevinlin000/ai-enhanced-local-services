# Browser-facing API base. Keep /api/java so the browser uses Next.js rewrites
# and avoids HTTPS -> HTTP mixed-content failures.
NEXT_PUBLIC_JAVA_API=/api/java

# Server-side rewrite targets used by next.config.ts.
# Local defaults are http://localhost:8081 and http://localhost:8000.
JAVA_API_PROXY_TARGET=http://your-java-api-host:8081
AI_API_PROXY_TARGET=http://your-ai-api-host:8000

# TapPay browser SDK settings, required for real card flow.
NEXT_PUBLIC_TAPPAY_APP_ID=0
NEXT_PUBLIC_TAPPAY_APP_KEY=your_tappay_app_key
NEXT_PUBLIC_TAPPAY_ENV=sandbox
